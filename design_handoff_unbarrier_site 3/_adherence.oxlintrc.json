{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blog/BlogCard/**",
              "components/blog/BlogHero/**",
              "components/blog/BlogIndex/**",
              "components/blog/NotionRenderer/**",
              "components/blog/PostFooter/**",
              "components/blog/PostHero/**",
              "components/blog/PostMeta/**",
              "components/blog/PreviewBanner/**",
              "components/blog/PullQuote/**",
              "components/blog/ShapeTag/**",
              "components/general/AplsBadge/**",
              "components/general/Button/**",
              "components/general/ContrastToggle/**",
              "components/general/CredentialStrip/**",
              "components/general/CtaCard/**",
              "components/general/Eyebrow/**",
              "components/general/Footer/**",
              "components/general/Glow/**",
              "components/general/Icon/**",
              "components/general/InclusionStrategyBand/**",
              "components/general/Mark/**",
              "components/general/MobileNavDrawer/**",
              "components/general/Nav/**",
              "components/general/NewsletterBand/**",
              "components/general/ReadingControls/**",
              "components/general/SayHiForm/**",
              "components/general/ScopeLine/**",
              "components/general/Section/**",
              "components/general/SevenQuestions/**",
              "components/general/StrandLockup/**",
              "components/general/StraplineLockup/**",
              "components/general/TodayBlock/**",
              "components/general/Wordmark/**",
              "components/home/IAmChooser/**",
              "components/isp-audit/AdminLoginForm/**",
              "components/isp-audit/AuditForm/**",
              "components/isp-audit/CatalogueChips/**",
              "components/isp-audit/DownloadResultsButton/**",
              "components/isp-audit/Heatmap/**",
              "components/isp-audit/IspAuditLayout/**",
              "components/isp-audit/IspAuditShell/**",
              "components/isp-audit/PlatformSelect/**",
              "components/isp-audit/RadarChart/**",
              "components/isp-audit/ScaleSelector/**",
              "components/readiness-check/ReadinessCheck/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Lexend|Comfortaa))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Lexend, Comfortaa."
      },
      {
        "selector": "JSXOpeningElement[name.name='AplsBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:ground|key|ref|className|style|children)$/]",
        "message": "<AplsBadge> doesn't accept that prop. Declared props: ground."
      },
      {
        "selector": "JSXOpeningElement[name.name='AplsBadge'] > JSXAttribute[name.name='ground'] > Literal[value!=/^(?:amethyst|white)$/]",
        "message": "<AplsBadge> ground must be one of 'amethyst' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuditForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:questionSet|key|ref|className|style|children)$/]",
        "message": "<AuditForm> doesn't accept that prop. Declared props: questionSet."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:post|variant|key|ref|className|style|children)$/]",
        "message": "<BlogCard> doesn't accept that prop. Declared props: post, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:standard|hero)$/]",
        "message": "<BlogCard> variant must be one of 'standard' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogIndex'] > JSXAttribute > JSXIdentifier[name!=/^(?:posts|key|ref|className|style|children)$/]",
        "message": "<BlogIndex> doesn't accept that prop. Declared props: posts."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|variant|color|external|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: href, children, variant, color, external."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost'."
