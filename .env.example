# MailerLite — server-only. Do NOT prefix with NEXT_PUBLIC_.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=185831469000688733

# TidyCal was retired as the booking surface on 21 Aug 2026 and Loop Breakers
# is paused — the NEXT_PUBLIC_TIDYCAL_* vars and lib/tidycal.ts are gone. If a
# booking provider is reintroduced, add its vars here.

# Email forward (Resend) — server-only.
RESEND_API_KEY=
SAY_HI_FORWARD_TO=hello@unbarrier.me

# Plausible — public.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=unbarrier.me

# Notion (blog content) — server-only. Internal integration token + the
# blog database id. The integration must be invited to the database via
# Notion's Connections menu, otherwise reads return 404.
NOTION_TOKEN=
NOTION_BLOG_DATABASE_ID=

# Blog draft preview — server-only. Long random string (e.g. `openssl
# rand -hex 32`). Hitting /blog/<slug>?preview=<this-value> bypasses the
# Status=Published filter so a Draft post renders for review. If unset,
# every preview attempt 404s (fail-closed).
BLOG_PREVIEW_SECRET=

# ISP audit tool (/isp-audit) — server-only.
# DATABASE_URL: auto-populated by the Vercel Postgres (Neon) integration once
# provisioned under Project → Storage → Create Database → Postgres. For local
# dev, copy the value from Vercel (Settings → Environment Variables) or run
# `vercel env pull .env.local`.
DATABASE_URL=
# ISP_AUDIT_ADMIN_KEY: passcode gating /isp-audit/dashboard and the CSV
# export. Pick any long random string — it's typed in by Nici, not a login.
ISP_AUDIT_ADMIN_KEY=
