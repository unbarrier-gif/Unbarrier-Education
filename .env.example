# MailerLite — server-only. Do NOT prefix with NEXT_PUBLIC_.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=185831469000688733

# TidyCal booking links — public, exposed to the browser.
NEXT_PUBLIC_TIDYCAL_TUESDAY=https://tidycal.com/nici/loop-breakers-sessions-vision-to-launch
NEXT_PUBLIC_TIDYCAL_GUEST=https://tidycal.com/nici/loop-breakers-sketch-noting-for-joy-and-for-thinking
NEXT_PUBLIC_TIDYCAL_COACHING=https://tidycal.com/nici/chat-with-nici
NEXT_PUBLIC_TIDYCAL_EHCP_FIT_CALL=https://tidycal.com/nici/chat-about-your-child

# Email forward (Resend) — server-only.
RESEND_API_KEY=
SAY_HI_FORWARD_TO=hello@unbarrier.me

# Plausible — public.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=unbarrier.me

# Notion (blog content) — server-only. Internal integration token + the
# blog database id. The integration must be invited to the database via
# Notion's Connections menu, otherwise reads return 404.
NOTION_TOKEN=
NOTION_BLOG_DATABASE_ID=

# Blog draft preview — server-only. Long random string (e.g. `openssl
# rand -hex 32`). Hitting /blog/<slug>?preview=<this-value> bypasses the
# Status=Published filter so a Draft post renders for review. If unset,
# every preview attempt 404s (fail-closed).
BLOG_PREVIEW_SECRET=
